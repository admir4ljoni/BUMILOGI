# Copy to .env.local and fill in. Bun loads .env.local for `bun run` scripts; Next loads it for dev/build.
# Local Postgres from `docker compose up -d db` (repo root):
DATABASE_URL=postgres://bumilogi:dev@127.0.0.1:5432/bumilogi

# Better Auth. Secret: any long random string, e.g. `openssl rand -hex 32`. URL: where the site runs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Later tasks:
# BLOB_READ_WRITE_TOKEN=     # task 20
# SMTP_USER=                 # task 22
# SMTP_PASS=                 # task 22
# GOOGLE_CLIENT_ID=          # task 28
# GOOGLE_CLIENT_SECRET=      # task 28
