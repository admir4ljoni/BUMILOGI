# Copy to .env.local and fill in. Bun loads .env.local for `bun run` scripts; Next loads it for dev/build.
# Local Postgres from `docker compose up -d db` (repo root):
DATABASE_URL=postgres://bumilogi:dev@127.0.0.1:5432/bumilogi

# Better Auth. Secret: any long random string, e.g. `openssl rand -hex 32`. URL: where the site runs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob, for edition images: Vercel dashboard → Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# Gmail that sends password-reset links: the address, and an app password (Google Account →
# Security → 2-Step Verification → App passwords). Left empty, the link is printed to the server log.
SMTP_USER=
SMTP_PASS=

# Later tasks:
# GOOGLE_CLIENT_ID=          # task 28
# GOOGLE_CLIENT_SECRET=      # task 28
